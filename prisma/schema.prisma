generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  trips        Trip[]
}

model Trip {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Calendar date stored at UTC midnight; exposed as "YYYY-MM-DD".
  plannedDate DateTime
  /// When the trip leaves the first stop; null = sunrise at the first stop.
  departAt    DateTime?
  /// Unguessable read-only share token (32 random bytes, base64url); null = not shared.
  shareToken  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stops       Stop[]

  @@index([userId])
}

model Stop {
  id           String   @id @default(cuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  /// 0-based position in the route sequence; kept contiguous by the data layer.
  order        Int
  name         String
  lat          Float
  lng          Float
  notes        String?
  /// "manual" | "suggested", validated in application code.
  source       String
  photoUrl     String?
  visited      Boolean  @default(false)
  /// "any" | "sunrise" | "golden" | "sunset", validated in application code.
  lightPref    String   @default("any")
  /// Minutes spent at the stop (0..480), validated in application code.
  dwellMinutes Int      @default(30)
  /// Free-text shot notes (max 2000 chars, validated in application code).
  shotNotes    String?
  /// JSON array of { text, done }, serialized and validated at the server boundary.
  shotChecklist String  @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tripId, order])
}
