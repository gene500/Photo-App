DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Mapbox public token (pk.*) used by the browser map
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Mapbox token used server-side for Directions + Geocoding (may be the same pk.* token)
MAPBOX_TOKEN=""
# Hosted deployment (Vercel). Leave unset for local dev.
# TURSO_DATABASE_URL=""        # libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=""
# BLOB_READ_WRITE_TOKEN=""     # Vercel Blob store; photos go here instead of UPLOAD_DIR
# Optional, server-only secret: Flickr photos + photo-count ranking. Without it Commons + Wikipedia are used.
# FLICKR_API_KEY=""
# Optional overrides
# OVERPASS_URL="https://overpass-api.de/api/interpreter"
# UPLOAD_DIR="uploads"
# EXTERNAL_APIS_FAKE="1"     # canned Mapbox/Overpass responses, no network
# NEXT_PUBLIC_MAP_FAKE="1"   # offline map preview instead of Mapbox GL
# Client address for per-IP rate limits (signup, login, shared trip pages). On Vercel it is read from the platform's
# header automatically. Anywhere else the proxy headers are ignored (all clients share one key) unless you set this
# AND every request passes through a reverse proxy you control that appends the real client to x-forwarded-for:
# TRUST_PROXY_HEADERS="1"
# TRUSTED_PROXY_DEPTH="1"    # proxies in front of the app (the x-forwarded-for entry this many from the right is used)
# Route optimizer load limits per server instance
# OPTIMIZE_MAX_CONCURRENT="2"
# OPTIMIZE_BUDGET_MS="1000"
