DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Mapbox public token (pk.*) used by the browser map
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Mapbox token used server-side for Directions + Geocoding (may be the same pk.* token)
MAPBOX_TOKEN=""
